# Ativa a camada de mocks (MSW REST + Socket.IO). Obrigatório enquanto não houver backend real.
VITE_ENABLE_MOCKS=true
# Base das chamadas REST (interceptadas pelo MSW)
VITE_API_URL=/api
# URL do servidor Socket.IO (interceptada pelo MSW via @mswjs/socket.io-binding)
VITE_SOCKET_URL=wss://realtime.kurio.mock
